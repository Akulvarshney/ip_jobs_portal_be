# Database
DATABASE_URL="postgresql://username:password@hostname:5432/ip_jobs"

# JWT & Server
JWT_SECRET="supersecretkey"
PORT=5002

# Google Auth
GOOGLE_CLIENT_ID="your-google-client-id"

# SMTP Mailer
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="\"Resolve Portal\" <your-email@gmail.com>"

# Cloudflare R2 Object Storage (Documents, Resumes, Profile Pictures, Logos)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
# Optional: Public R2 bucket custom domain / dev URL (e.g. https://pub-xxxx.r2.dev or https://assets.yourdomain.com)
R2_PUBLIC_URL=""
